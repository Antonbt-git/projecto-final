# URL base de la API del backend (el mismo backend que usa el panel
# administrativo). En Vercel, configura esta variable en
# Settings -> Environment Variables con la URL real de tu backend
# desplegado (Render, Railway, etc.), por ejemplo:
# VITE_API_URL=https://mi-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api
